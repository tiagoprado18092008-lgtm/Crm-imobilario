generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_OWNER
  AGENCY_ADMIN
  TEAM_LEADER
  CONSULTANT
  USER
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Agency {
  id          String  @id @default(cuid())
  name        String
  legalName   String?
  slug        String  @unique
  logoUrl     String?
  coverUrl    String?
  description String?
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?
  niche       String?
  amiNumber   String?
  currency    String  @default("EUR")
  apiKey      String? @unique
  isActive    Boolean @default(true)

  users                  User[]
  automations            Automation[]
  automationRules        AutomationRule[]
  settings               AgencySettings?
  pipelines              Pipeline[]
  opportunities          Opportunity[]
  appointmentCalendars   AppointmentCalendar[]
  whatsappSessions       WhatsAppSession[]
  systemSettings         SystemSettings[]
  conversations          Conversation[]
  contact                Contact[]
  interaction            Interaction[]
  task                   Task[]
  message                Message[]
  phoneNumber            PhoneNumber[]
  appointment            Appointment[]
  emailCampaign          EmailCampaign[]
  emailCampaignRecipient EmailCampaignRecipient[]
  form                   Form[]
  formSubmission         FormSubmission[]
  automationLog          AutomationLog[]
  automationEnrollment   AutomationEnrollment[]
  automationRun          AutomationRun[]
  calendarIntegration    CalendarIntegration[]
  calendarEvent          CalendarEvent[]
  calendarSlot           CalendarSlot[]
  pipelineStage          PipelineStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgencySettings {
  id                 String   @id @default(cuid())
  agencyId           String   @unique
  agency             Agency   @relation(fields: [agencyId], references: [id])
  whitelabelEnabled  Boolean  @default(false)
  primaryColor       String   @default("#0f2553")
  defaultPermissions Json     @default("{}")
  securitySettings   Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  agencyId   String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([userId, createdAt])
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String?
  googleId            String?  @unique
  clerkUserId         String?  @unique
  role                UserRole @default(CONSULTANT)
  phone               String?
  avatarUrl           String?
  isActive            Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  amiNumber           String?

  agencyId    String?
  agency      Agency? @relation(fields: [agencyId], references: [id])
  permissions Json?

  supervisorId String?
  supervisor   User?   @relation("SupervisorSubAgents", fields: [supervisorId], references: [id])
  subAgents    User[]  @relation("SupervisorSubAgents")

  contacts      Contact[]
  opportunities Opportunity[]
  tasks         Task[]
  interactions  Interaction[]

  assignedConversations Conversation[]        @relation("ConversationAssigned")
  sentMessages          Message[]             @relation("MessageSentBy")
  phoneNumbers          PhoneNumber[]
  appointments          Appointment[]
  campaigns             EmailCampaign[]       @relation("CampaignCreatedBy")
  assignedForms         Form[]                @relation("FormAssignedTo")
  calendarIntegrations  CalendarIntegration[]
  calendarEvents        CalendarEvent[]
  calendarSlots         CalendarSlot[]
  whatsappSessions      WhatsAppSession[]
  refreshTokens         RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          String  @id @default(cuid())
  name        String
  email       String?
  phone       String?
  whatsapp    String?
  type        String  @default("LEAD")
  status      String  @default("NEW")
  source      String?
  notes       String?
  preferences String?

  assignedToId      String
  assignedTo        User      @relation(fields: [assignedToId], references: [id])
  score             Int       @default(0)
  tags              String[]  @default([])
  gdprConsent       Boolean   @default(false)
  gdprConsentDate   DateTime?
  gdprConsentOrigin String?
  city              String?
  postalCode        String?
  nif               String?
  birthday          DateTime?
  lastContactedAt   DateTime?

  opportunities         Opportunity[]
  interactions          Interaction[]
  tasks                 Task[]
  conversations         Conversation[]
  appointments          Appointment[]
  campaignRecipients    EmailCampaignRecipient[]
  calendarEvents        CalendarEvent[]
  formSubmissions       FormSubmission[]
  automationEnrollments AutomationEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, assignedToId, createdAt(sort: Desc)])
}

model Opportunity {
  id                String         @id @default(cuid())
  title             String
  stage             String         @default("LEAD_IN")
  value             Float?
  probability       Int            @default(50)
  source            String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  position          Int            @default(0)
  pipelineId        String?
  pipeline          Pipeline?      @relation(fields: [pipelineId], references: [id])
  stageId           String?
  pipelineStage     PipelineStage? @relation(fields: [stageId], references: [id])

  contactId    String
  contact      Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User    @relation(fields: [assignedToId], references: [id])
  agencyId     String?
  agency       Agency? @relation(fields: [agencyId], references: [id])

  interactions Interaction[]
  tasks        Task[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, stageId, position])
  @@index([agencyId, stage, expectedCloseDate])
}

model Interaction {
  id        String  @id @default(cuid())
  type      String
  subject   String?
  body      String
  direction String  @default("OUTBOUND")
  metadata  String? // JSON string (call details: sid, duration, status, fromNumber, toNumber, etc.)

  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, contactId, createdAt(sort: Desc)])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?

  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId  String
  assignedTo    User         @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, assignedToId, status, dueDate])
}

model Conversation {
  id         String  @id @default(cuid())
  channel    String // WHATSAPP, EMAIL, INSTAGRAM, INTERNAL
  externalId String? // thread ID / phone / email address
  status     String  @default("OPEN") // OPEN, RESOLVED, ARCHIVED

  isRead          Boolean @default(true)
  isStarred       Boolean @default(false)
  lastMessageText String?

  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("ConversationAssigned", fields: [assignedToId], references: [id])

  // Tenant owner. Previously reached indirectly via Location; denormalised here
  // when the Location model was removed so isolation stays enforceable.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  messages Message[]

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contactId])
  @@index([agencyId, lastMessageAt])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  agencyId  String?
  name      String
  channel   String // WHATSAPP | EMAIL | SMS | ALL
  subject   String?
  body      String   @db.Text
  variables String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationRule {
  id        String          @id @default(cuid())
  name      String
  trigger   String // NEW_LEAD, VISIT_SCHEDULED, MISSED_CALL, NO_RESPONSE_2H, LEAD_QUALIFIED, PROPOSAL_SENT
  isActive  Boolean         @default(true)
  actions   String // JSON array of actions
  agencyId  String?
  agency    Agency?         @relation(fields: [agencyId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  logs      AutomationLog[]
}

model AutomationLog {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id])
  contactId  String?
  trigger    String
  status     String         @default("SUCCESS") // SUCCESS, FAILED
  error      String?
  executedAt DateTime       @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  direction  String // INBOUND, OUTBOUND
  channel    String // WHATSAPP, EMAIL, INSTAGRAM, INTERNAL, SMS
  content    String
  subject    String? // for email
  status     String  @default("SENT") // SENT, DELIVERED, READ, FAILED
  externalId String? // message ID from WhatsApp/Meta

  sentById String?
  sentBy   User?   @relation("MessageSentBy", fields: [sentById], references: [id])

  metadata  String? // JSON string for extra data (attachments, etc.)
  createdAt DateTime @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([conversationId, createdAt])
}

model PhoneNumber {
  id               String  @id @default(cuid())
  number           String  @unique
  friendlyName     String?
  twilioSid        String?
  status           String  @default("ACTIVE") // ACTIVE, RELEASED
  countryCode      String
  numberType       String  @default("LOCAL") // LOCAL, TOLLFREE, MOBILE
  capabilities     String  @default("{\"voice\":true,\"sms\":true}")
  monthlyPrice     Float   @default(1.15)
  source           String  @default("TWILIO") // TWILIO, EXTERNAL_VERIFIED
  ringAll          Boolean @default(false)
  voicemailEnabled Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model AppointmentCalendar {
  id           String        @id @default(cuid())
  name         String
  color        String        @default("#6366f1")
  description  String?
  agencyId     String?
  agency       Agency?       @relation(fields: [agencyId], references: [id])
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  type        String   @default("VISIT") // VISIT, CALL, MEETING, OTHER

  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId  String
  assignedTo    User         @relation(fields: [assignedToId], references: [id])

  reminderSent Boolean @default(false)
  notes        String?
  location     String?

  calendarId String?
  calendar   AppointmentCalendar? @relation(fields: [calendarId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, assignedToId, startAt])
}

model EmailCampaign {
  id      String @id @default(cuid())
  name    String
  subject String
  body    String // HTML content
  status  String @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, CANCELLED
  type    String @default("BROADCAST") // BROADCAST, SEQUENCE

  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  openCount   Int       @default(0)
  clickCount  Int       @default(0)

  // Target: JSON filter criteria (e.g., {"type":"LEAD","status":"NEW"})
  targetFilter String @default("{}")

  createdById String
  createdBy   User   @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  recipients EmailCampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model EmailCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id])
  contactId  String
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email      String
  status     String        @default("PENDING") // PENDING, SENT, OPENED, CLICKED, BOUNCED, UNSUBSCRIBED
  sentAt     DateTime?
  openedAt   DateTime?
  createdAt  DateTime      @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Form {
  id              String  @id @default(cuid())
  name            String
  description     String?
  fields          String // JSON array of field definitions
  isActive        Boolean @default(true)
  submitAction    String  @default("CREATE_CONTACT") // CREATE_CONTACT, CREATE_LEAD
  thankYouMessage String  @default("Obrigado! Entraremos em contacto em breve.")

  assignedToId String?
  assignedTo   User?   @relation("FormAssignedTo", fields: [assignedToId], references: [id])

  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id])
  data      String // JSON of submitted field values
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("CONSULTANT")
  type        String    @default("CONSULTANT")
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  permissions Json?
  agencyId    String?
}

model Automation {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  trigger     Json
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments AutomationEnrollment[]
  runs        AutomationRun[]
}

model AutomationEnrollment {
  id              String           @id @default(cuid())
  automationId    String
  automation      Automation       @relation(fields: [automationId], references: [id])
  contactId       String
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(ACTIVE)
  currentStepId   String?
  waitingUntil    DateTime?
  waitingForEvent String?
  context         Json             @default("{}")
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?

  runs AutomationRun[]

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model AutomationRun {
  id           String                @id @default(cuid())
  automationId String
  automation   Automation            @relation(fields: [automationId], references: [id])
  enrollmentId String?
  enrollment   AutomationEnrollment? @relation(fields: [enrollmentId], references: [id])
  stepId       String
  status       RunStatus             @default(PENDING)
  input        Json
  output       Json?
  error        String?
  executedAt   DateTime              @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model CalendarIntegration {
  id                String    @id @default(cuid())
  userId            String
  provider          String // "google" | "outlook"
  email             String
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  tokenExpiresAt    DateTime
  webhookChannelId  String?
  webhookResourceId String?
  webhookExpiry     DateTime?
  syncToken         String?
  deltaLink         String?
  lastSyncedAt      DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id])

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@unique([userId, provider])
}

model CalendarEvent {
  id               String    @id @default(cuid())
  userId           String
  integrationId    String?
  externalId       String?
  externalProvider String? // "google" | "outlook" | null
  title            String
  description      String?   @db.Text
  location         String?
  startAt          DateTime
  endAt            DateTime
  isAllDay         Boolean   @default(false)
  isRecurring      Boolean   @default(false)
  recurringRule    String?
  status           String    @default("confirmed")
  eventType        String    @default("other")
  color            String?
  attendees        Json?
  contactId        String?
  opportunityId    String?
  meetLink         String?
  teamsLink        String?
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
  contact          Contact?  @relation(fields: [contactId], references: [id])

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@unique([userId, externalId, externalProvider])
  @@index([userId, startAt, endAt])
  @@index([agencyId, userId, startAt])
}

model CalendarSlot {
  id          String  @id @default(cuid())
  userId      String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id])

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

// Key-value store for system settings that must persist across deployments
// Values for sensitive keys are stored encrypted
model SystemSettings {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  key       String
  value     String // plain text or AES-encrypted (prefix "enc:")
  updatedAt DateTime @updatedAt

  @@unique([agencyId, key])
}

model Pipeline {
  id            String          @id @default(cuid())
  name          String
  position      Int             @default(0)
  agencyId      String?
  agency        Agency?         @relation(fields: [agencyId], references: [id])
  stages        PipelineStage[]
  opportunities Opportunity[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PipelineStage {
  id            String        @id @default(cuid())
  name          String
  color         String        @default("#6366f1")
  position      Int           @default(0)
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([pipelineId, position])
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creds     String   @db.Text
  keys      String?  @db.Text
  status    String   @default("DISCONNECTED")
  phone     String?
  updatedAt DateTime @updatedAt

  @@unique([agencyId, userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
