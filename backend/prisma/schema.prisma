generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_OWNER
  AGENCY_ADMIN
  TEAM_LEADER
  CONSULTANT
  USER
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Agency {
  id          String  @id @default(cuid())
  name        String
  legalName   String?
  slug        String  @unique
  logoUrl     String?
  coverUrl    String?
  description String?
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?
  niche       String?
  amiNumber   String?
  currency    String  @default("EUR")
  apiKey      String? @unique
  isActive    Boolean @default(true)

  users                  User[]
  automations            Automation[]
  automationRules        AutomationRule[]
  settings               AgencySettings?
  pipelines              Pipeline[]
  opportunities          Opportunity[]
  appointmentCalendars   AppointmentCalendar[]
  whatsappSessions       WhatsAppSession[]
  systemSettings         SystemSettings[]
  conversations          Conversation[]
  contact                Contact[]
  interaction            Interaction[]
  task                   Task[]
  message                Message[]
  phoneNumber            PhoneNumber[]
  appointment            Appointment[]
  emailCampaign          EmailCampaign[]
  emailCampaignRecipient EmailCampaignRecipient[]
  form                   Form[]
  formSubmission         FormSubmission[]
  automationLog          AutomationLog[]
  automationEnrollment   AutomationEnrollment[]
  automationRun          AutomationRun[]
  calendarIntegration    CalendarIntegration[]
  calendarEvent          CalendarEvent[]
  calendarSlot           CalendarSlot[]
  pipelineStage          PipelineStage[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Company        Company[]
  Lead           Lead[]
  SavedView      SavedView[]
  Call           Call[]
  CallEvent      CallEvent[]
  Recording      Recording[]
  AgentExtension AgentExtension[]
}

model AgencySettings {
  id                 String   @id @default(cuid())
  agencyId           String   @unique
  agency             Agency   @relation(fields: [agencyId], references: [id])
  whitelabelEnabled  Boolean  @default(false)
  primaryColor       String   @default("#0f2553")
  defaultPermissions Json     @default("{}")
  securitySettings   Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  agencyId   String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([userId, createdAt])
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String?
  googleId            String?  @unique
  clerkUserId         String?  @unique
  role                UserRole @default(CONSULTANT)
  phone               String?
  avatarUrl           String?
  isActive            Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  amiNumber           String?

  agencyId    String?
  agency      Agency? @relation(fields: [agencyId], references: [id])
  permissions Json?

  supervisorId String?
  supervisor   User?   @relation("SupervisorSubAgents", fields: [supervisorId], references: [id])
  subAgents    User[]  @relation("SupervisorSubAgents")

  contacts      Contact[]
  opportunities Opportunity[]
  tasks         Task[]
  interactions  Interaction[]

  assignedConversations Conversation[]        @relation("ConversationAssigned")
  sentMessages          Message[]             @relation("MessageSentBy")
  phoneNumbers          PhoneNumber[]
  appointments          Appointment[]
  campaigns             EmailCampaign[]       @relation("CampaignCreatedBy")
  assignedForms         Form[]                @relation("FormAssignedTo")
  calendarIntegrations  CalendarIntegration[]
  calendarEvents        CalendarEvent[]
  calendarSlots         CalendarSlot[]
  whatsappSessions      WhatsAppSession[]
  refreshTokens         RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCompanies Company[]   @relation("CompanyOwner")
  ownedLeads     Lead[]      @relation("LeadOwner")
  savedViews     SavedView[] @relation("SavedViewOwner")

  calls          Call[]
  agentExtension AgentExtension?
}

model Contact {
  id          String  @id @default(cuid())
  name        String
  email       String?
  phone       String?
  whatsapp    String?
  type        String  @default("LEAD")
  status      String  @default("NEW")
  source      String?
  notes       String?
  preferences String?

  assignedToId      String
  assignedTo        User      @relation(fields: [assignedToId], references: [id])
  score             Int       @default(0)
  tags              String[]  @default([])
  gdprConsent       Boolean   @default(false)
  gdprConsentDate   DateTime?
  gdprConsentOrigin String?
  city              String?
  postalCode        String?
  nif               String?
  birthday          DateTime?
  lastContactedAt   DateTime?

  opportunities         Opportunity[]
  interactions          Interaction[]
  tasks                 Task[]
  conversations         Conversation[]
  appointments          Appointment[]
  campaignRecipients    EmailCampaignRecipient[]
  calendarEvents        CalendarEvent[]
  formSubmissions       FormSubmission[]
  automationEnrollments AutomationEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  // A contact belongs to the organisation being sold to, not the other way round.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  leads     Lead[]

  calls Call[]

  @@index([agencyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, assignedToId, createdAt(sort: Desc)])
}

model Opportunity {
  id    String @id @default(cuid())
  title String

  /// Denormalised activity clock. Recomputing "days since last activity"
  /// across every card on every board render is what makes a kanban crawl.
  lastActivityAt DateTime?
  nextActivityAt DateTime?
  /// When the deal crossed its stage's rot threshold. Null while healthy.
  rottingAt      DateTime?
  /// Set on each stage change, so rotting measures time in the current stage.
  stageEnteredAt DateTime?

  stage             String         @default("LEAD_IN")
  value             Float?
  probability       Int            @default(50)
  source            String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  position          Int            @default(0)
  pipelineId        String?
  pipeline          Pipeline?      @relation(fields: [pipelineId], references: [id])
  stageId           String?
  pipelineStage     PipelineStage? @relation(fields: [stageId], references: [id])

  contactId    String
  contact      Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User    @relation(fields: [assignedToId], references: [id])
  agencyId     String?
  agency       Agency? @relation(fields: [agencyId], references: [id])

  interactions Interaction[]
  tasks        Task[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  calls Call[]

  @@index([agencyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, stageId, position])
  @@index([agencyId, stage, expectedCloseDate])
  @@index([agencyId, nextActivityAt])
  @@index([agencyId, rottingAt])
}

model Interaction {
  id        String  @id @default(cuid())
  type      String
  subject   String?
  body      String
  direction String  @default("OUTBOUND")
  metadata  String? // JSON string (call details: sid, duration, status, fromNumber, toNumber, etc.)

  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, contactId, createdAt(sort: Desc)])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?

  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId  String
  assignedTo    User         @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, assignedToId, status, dueDate])
}

model Conversation {
  id         String  @id @default(cuid())
  channel    String // WHATSAPP, EMAIL, INSTAGRAM, INTERNAL
  externalId String? // thread ID / phone / email address
  status     String  @default("OPEN") // OPEN, RESOLVED, ARCHIVED

  isRead          Boolean @default(true)
  isStarred       Boolean @default(false)
  lastMessageText String?

  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("ConversationAssigned", fields: [assignedToId], references: [id])

  // Tenant owner. Previously reached indirectly via Location; denormalised here
  // when the Location model was removed so isolation stays enforceable.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  messages Message[]

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contactId])
  @@index([agencyId, lastMessageAt])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  agencyId  String?
  name      String
  channel   String // WHATSAPP | EMAIL | SMS | ALL
  subject   String?
  body      String   @db.Text
  variables String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationRule {
  id        String          @id @default(cuid())
  name      String
  trigger   String // NEW_LEAD, VISIT_SCHEDULED, MISSED_CALL, NO_RESPONSE_2H, LEAD_QUALIFIED, PROPOSAL_SENT
  isActive  Boolean         @default(true)
  actions   String // JSON array of actions
  agencyId  String?
  agency    Agency?         @relation(fields: [agencyId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  logs      AutomationLog[]
}

model AutomationLog {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id])
  contactId  String?
  trigger    String
  status     String         @default("SUCCESS") // SUCCESS, FAILED
  error      String?
  executedAt DateTime       @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  direction  String // INBOUND, OUTBOUND
  channel    String // WHATSAPP, EMAIL, INSTAGRAM, INTERNAL, SMS
  content    String
  subject    String? // for email
  status     String  @default("SENT") // SENT, DELIVERED, READ, FAILED
  externalId String? // message ID from WhatsApp/Meta

  sentById String?
  sentBy   User?   @relation("MessageSentBy", fields: [sentById], references: [id])

  metadata  String? // JSON string for extra data (attachments, etc.)
  createdAt DateTime @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([conversationId, createdAt])
}

model PhoneNumber {
  id               String  @id @default(cuid())
  number           String  @unique
  friendlyName     String?
  twilioSid        String?
  status           String  @default("ACTIVE") // ACTIVE, RELEASED
  countryCode      String
  numberType       String  @default("LOCAL") // LOCAL, TOLLFREE, MOBILE
  capabilities     String  @default("{\"voice\":true,\"sms\":true}")
  monthlyPrice     Float   @default(1.15)
  source           String  @default("TWILIO") // TWILIO, EXTERNAL_VERIFIED
  ringAll          Boolean @default(false)
  voicemailEnabled Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model AppointmentCalendar {
  id           String        @id @default(cuid())
  name         String
  color        String        @default("#6366f1")
  description  String?
  agencyId     String?
  agency       Agency?       @relation(fields: [agencyId], references: [id])
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  type        String   @default("VISIT") // VISIT, CALL, MEETING, OTHER

  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId  String
  assignedTo    User         @relation(fields: [assignedToId], references: [id])

  reminderSent Boolean @default(false)
  notes        String?
  location     String?

  calendarId String?
  calendar   AppointmentCalendar? @relation(fields: [calendarId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([agencyId, assignedToId, startAt])
}

model EmailCampaign {
  id      String @id @default(cuid())
  name    String
  subject String
  body    String // HTML content
  status  String @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, CANCELLED
  type    String @default("BROADCAST") // BROADCAST, SEQUENCE

  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  openCount   Int       @default(0)
  clickCount  Int       @default(0)

  // Target: JSON filter criteria (e.g., {"type":"LEAD","status":"NEW"})
  targetFilter String @default("{}")

  createdById String
  createdBy   User   @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  recipients EmailCampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model EmailCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id])
  contactId  String
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email      String
  status     String        @default("PENDING") // PENDING, SENT, OPENED, CLICKED, BOUNCED, UNSUBSCRIBED
  sentAt     DateTime?
  openedAt   DateTime?
  createdAt  DateTime      @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Form {
  id              String  @id @default(cuid())
  name            String
  description     String?
  fields          String // JSON array of field definitions
  isActive        Boolean @default(true)
  submitAction    String  @default("CREATE_CONTACT") // CREATE_CONTACT, CREATE_LEAD
  thankYouMessage String  @default("Obrigado! Entraremos em contacto em breve.")

  assignedToId String?
  assignedTo   User?   @relation("FormAssignedTo", fields: [assignedToId], references: [id])

  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id])
  data      String // JSON of submitted field values
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("CONSULTANT")
  type        String    @default("CONSULTANT")
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  permissions Json?
  agencyId    String?
}

model Automation {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  trigger     Json
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments AutomationEnrollment[]
  runs        AutomationRun[]
}

model AutomationEnrollment {
  id              String           @id @default(cuid())
  automationId    String
  automation      Automation       @relation(fields: [automationId], references: [id])
  contactId       String
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(ACTIVE)
  currentStepId   String?
  waitingUntil    DateTime?
  waitingForEvent String?
  context         Json             @default("{}")
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?

  runs AutomationRun[]

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model AutomationRun {
  id           String                @id @default(cuid())
  automationId String
  automation   Automation            @relation(fields: [automationId], references: [id])
  enrollmentId String?
  enrollment   AutomationEnrollment? @relation(fields: [enrollmentId], references: [id])
  stepId       String
  status       RunStatus             @default(PENDING)
  input        Json
  output       Json?
  error        String?
  executedAt   DateTime              @default(now())

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

model CalendarIntegration {
  id                String    @id @default(cuid())
  userId            String
  provider          String // "google" | "outlook"
  email             String
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  tokenExpiresAt    DateTime
  webhookChannelId  String?
  webhookResourceId String?
  webhookExpiry     DateTime?
  syncToken         String?
  deltaLink         String?
  lastSyncedAt      DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id])

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@unique([userId, provider])
}

model CalendarEvent {
  id               String    @id @default(cuid())
  userId           String
  integrationId    String?
  externalId       String?
  externalProvider String? // "google" | "outlook" | null
  title            String
  description      String?   @db.Text
  location         String?
  startAt          DateTime
  endAt            DateTime
  isAllDay         Boolean   @default(false)
  isRecurring      Boolean   @default(false)
  recurringRule    String?
  status           String    @default("confirmed")
  eventType        String    @default("other")
  color            String?
  attendees        Json?
  contactId        String?
  opportunityId    String?
  meetLink         String?
  teamsLink        String?
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
  contact          Contact?  @relation(fields: [contactId], references: [id])

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@unique([userId, externalId, externalProvider])
  @@index([userId, startAt, endAt])
  @@index([agencyId, userId, startAt])
}

model CalendarSlot {
  id          String  @id @default(cuid())
  userId      String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id])

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])
}

// Key-value store for system settings that must persist across deployments
// Values for sensitive keys are stored encrypted
model SystemSettings {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  key       String
  value     String // plain text or AES-encrypted (prefix "enc:")
  updatedAt DateTime @updatedAt

  @@unique([agencyId, key])
}

model Pipeline {
  id            String          @id @default(cuid())
  name          String
  position      Int             @default(0)
  agencyId      String?
  agency        Agency?         @relation(fields: [agencyId], references: [id])
  stages        PipelineStage[]
  opportunities Opportunity[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PipelineStage {
  id       String @id @default(cuid())
  name     String
  color    String @default("#6366f1")
  position Int    @default(0)

  /// Odds of closing from this stage, used for the weighted forecast.
  probability Int @default(50)

  /// Days a deal may sit here before it counts as rotting. Null disables it.
  rotDays Int?

  /// Fields a deal must have before it may enter this stage, e.g.
  /// ["value", "expectedCloseDate"]. Enforced on the move, not on save, so
  /// the prompt appears where the decision is made.
  requiredFields Json?
  pipelineId     String
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Tenant owner, denormalised so every query can filter on one indexed column.
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  @@index([pipelineId, position])
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creds     String   @db.Text
  keys      String?  @db.Text
  status    String   @default("DISCONNECTED")
  phone     String?
  updatedAt DateTime @updatedAt

  @@unique([agencyId, userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Sales core ───────────────────────────────────────────────────────────────

/// Business sectors AlphaScale sells into. Clinics dominate; construction and
/// real estate are historical and kept so older records stay classifiable.
enum Sector {
  FISIOTERAPIA
  DENTARIA
  VETERINARIA
  MEDICINA_ESTETICA
  MEDICINA_CHINESA
  CONSTRUCAO
  IMOBILIARIA
  OUTRO
}

enum CompanyType {
  LEAD
  PROSPECT
  CLIENTE
  EX_CLIENTE
}

enum LeadState {
  NOVO
  A_TRABALHAR
  QUALIFICADO
  DESQUALIFICADO
  NURTURING
}

/// Call outcome. Recording one is mandatory when a call ends: a call with no
/// disposition is a call that never happened as far as the pipeline knows.
enum CallDisposition {
  ATENDEU_INTERESSADO
  ATENDEU_SEM_INTERESSE
  GATEKEEPER
  PEDIU_INFO_EMAIL
  REMARCAR
  NAO_ATENDEU
  VOICEMAIL
  NUMERO_ERRADO
  NAO_CONTACTAR
  REUNIAO_MARCADA
}

/// The organisation. B2B sells to companies, so this is the parent record:
/// a clinic has many contacts, deals, projects and subscriptions.
model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  nif       String?
  domain    String?
  website   String?
  phone     String?
  email     String?

  address  String?
  city     String?
  /// Portuguese administrative divisions; used for territory filtering.
  distrito String?
  concelho String?

  sector Sector      @default(OUTRO)
  type   CompanyType @default(LEAD)
  size   String?

  /// Prospecting signals gathered before the first call.
  hasWebsite        Boolean @default(false)
  googleBusinessUrl String?
  instagramUrl      String?
  facebookUrl       String?
  prospectingNotes  String?

  ownerId String?
  owner   User?   @relation("CompanyOwner", fields: [ownerId], references: [id])

  source String?
  tags   String[] @default([])
  notes  String?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  calls Call[]

  @@index([agencyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, type, sector])
  @@index([agencyId, nif])
}

/// Cold-call triage, deliberately outside the pipeline.
///
/// This is the fix for a pipeline where 2,882 of 3,442 "opportunities" sat in
/// the first stage: a call list is not a pipeline. Leads live here until they
/// qualify, and only then become a Deal.
model Lead {
  id String @id @default(cuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  /// Denormalised so a lead can be imported and called before anyone decides
  /// whether it deserves a Company record.
  companyName String?
  contactName String?
  phone       String?
  email       String?

  source String?
  state  LeadState @default(NOVO)

  disqualifiedReason String?

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id])

  /// Dialer bookkeeping. nextAttemptAt is what the call queue sorts on.
  attempts        Int              @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  lastDisposition CallDisposition?

  /// Qualification checklist: has a site, runs ads, who decides, budget, pain.
  qualification Json?

  notes String?
  tags  String[] @default([])

  /// Honoured by the dialer, every sequence and every future import.
  optOutCalls    Boolean @default(false)
  optOutEmail    Boolean @default(false)
  optOutWhatsApp Boolean @default(false)

  /// Set when the lead converts, so the history survives the move.
  convertedToOpportunityId String?
  convertedAt              DateTime?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  calls Call[]

  @@index([agencyId, state, nextAttemptAt])
  @@index([agencyId, ownerId, state])
  @@index([agencyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, phone])
}

/// A saved filter. One engine drives lists, call queues and bulk actions, so
/// filtering is never built twice.
model SavedView {
  id     String @id @default(cuid())
  name   String
  /// Which list this view applies to: "lead", "contact", "opportunity".
  entity String

  filters Json
  sort    Json?
  columns Json?

  /// Shared views are visible to the whole workspace; private ones are not.
  isShared    Boolean @default(false)
  /// Marks the view as selectable as a power-dialer queue.
  isCallQueue Boolean @default(false)

  icon     String?
  position Int     @default(0)

  ownerId String
  owner   User   @relation("SavedViewOwner", fields: [ownerId], references: [id])

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, entity, position])
}

// ─── Telephony ────────────────────────────────────────────────────────────────

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallState {
  INICIADA
  A_TOCAR
  ATENDIDA
  TERMINADA
  FALHADA
}

enum TelephonyProvider {
  ZADARMA
  TWILIO
}

/// One call. Calls used to be rows in Interaction, which left no room for
/// disposition, recording, cost or provider reconciliation.
model Call {
  id String @id @default(cuid())

  direction CallDirection
  state     CallState     @default(INICIADA)

  /// E.164 both sides.
  from String
  to   String

  /// Whole call including ringing, and the part actually connected. The second
  /// is the one worth reporting on.
  duration Int?
  talkTime Int?

  /// Why the call went as it did. Mandatory at wrap-up: a call without one is
  /// a call the pipeline cannot learn from.
  disposition CallDisposition?
  notes       String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id])
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id])
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id])
  dealId    String?
  deal      Opportunity? @relation(fields: [dealId], references: [id])

  provider       TelephonyProvider @default(ZADARMA)
  providerCallId String?
  cost           Float?
  currency       String?

  /// Set when the call came from a power-dialer session.
  queueId String?

  recording Recording?
  events    CallEvent[]

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([agencyId, startedAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, userId, startedAt(sort: Desc)])
  @@index([providerCallId])
  @@index([agencyId, disposition])
}

/// Raw webhook log, for audit and for reconciling against provider statistics.
/// Kept separate from Call so a malformed payload can never corrupt the call.
model CallEvent {
  id String @id @default(cuid())

  callId String?
  call   Call?   @relation(fields: [callId], references: [id], onDelete: Cascade)

  provider       TelephonyProvider @default(ZADARMA)
  providerCallId String?
  eventType      String
  payload        Json

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now())

  /// Provider retries deliver the same event twice; this makes that a no-op.
  @@unique([providerCallId, eventType])
  @@index([agencyId, createdAt(sort: Desc)])
}

/// A recording, re-hosted in our own storage.
///
/// Provider quota is small (200MB free, 2GB on Office) and their links expire,
/// so every recording is downloaded and stored by us on the day it is made.
model Recording {
  id String @id @default(cuid())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  /// Our own storage, not the provider's.
  url       String
  duration  Int?
  sizeBytes Int?

  transcript String?

  /// Retention. GDPR: recordings for calls that did not convert are deleted
  /// after 30 days (CNPD 1039/2017 for quality and training). A converted lead
  /// moves to a pre-contractual basis with a longer, configurable period.
  deleteAt DateTime?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now())

  @@index([agencyId, deleteAt])
}

/// A user's SIP extension on the PBX.
model AgentExtension {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  extension   String
  /// Encrypted at rest; the browser receives short-lived credentials from an
  /// authenticated endpoint rather than these.
  sipLogin    String?
  sipPassword String?

  isActive Boolean @default(true)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, extension])
}
